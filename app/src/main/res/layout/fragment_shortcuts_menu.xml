<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shortcuts_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <GridLayout
        android:id="@+id/shortcuts_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/softkey_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/shortcut_mobile_data"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="8dp">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <ImageView
                    android:id="@+id/overlay_mobile_data"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/shortcut_focus_overlay_square"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btn_mobile_data"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_bg"
                    android:src="@drawable/ic_mobile_data"
                    android:contentDescription="@string/shortcut_mobile_data"
                    android:defaultFocusHighlightEnabled="false" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shortcut_mobile_data"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shortcut_bluetooth"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="8dp">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <ImageView
                    android:id="@+id/overlay_bluetooth"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/shortcut_focus_overlay_square"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btn_bluetooth"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_bg"
                    android:src="@drawable/ic_bluetooth"
                    android:contentDescription="@string/shortcut_bluetooth"
                    android:defaultFocusHighlightEnabled="false" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shortcut_bluetooth"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shortcut_airplane_mode"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="8dp">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <ImageView
                    android:id="@+id/overlay_airplane_mode"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/shortcut_focus_overlay_square"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btn_airplane_mode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_bg"
                    android:src="@drawable/ic_airplane_mode"
                    android:contentDescription="@string/shortcut_airplane_mode"
                    android:defaultFocusHighlightEnabled="false" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shortcut_airplane_mode"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shortcut_dnd"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="8dp">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <ImageView
                    android:id="@+id/overlay_dnd"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/shortcut_focus_overlay_square"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btn_dnd"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_bg"
                    android:src="@drawable/ic_dnd"
                    android:contentDescription="@string/shortcut_dnd"
                    android:defaultFocusHighlightEnabled="false" />
            </FrameLayout>
            <TextView
                android:id="@+id/shortcut_dnd_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shortcut_dnd"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shortcut_location"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="8dp">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <ImageView
                    android:id="@+id/overlay_location"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/shortcut_focus_overlay_square"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btn_location"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_bg"
                    android:src="@drawable/ic_location"
                    android:contentDescription="@string/shortcut_location"
                    android:defaultFocusHighlightEnabled="false" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shortcut_location"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shortcut_brightness"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="8dp">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <ImageView
                    android:id="@+id/overlay_brightness"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/shortcut_focus_overlay_square"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btn_brightness"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/brightness_progress"
                    android:src="@drawable/ic_brightness"
                    android:contentDescription="@string/shortcut_brightness"
                    android:defaultFocusHighlightEnabled="false" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shortcut_brightness"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>

    </GridLayout>

    <!-- Softkey bar anchored to bottom -->
    <com.ham.flipphonelauncher.ui.SoftkeyBarView
        android:id="@+id/softkey_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
