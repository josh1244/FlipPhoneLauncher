<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FlipPhoneLauncher" parent="@android:style/Theme.Wallpaper.NoTitleBar.Fullscreen">
        <!-- Primary brand color - you may not need these for night theme if UI is minimal -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color - you may not need these -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- For night mode, status bar icons are typically light (false) -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Ensure the window background is transparent to show wallpaper -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>