        <ImageButton android:id="@id/playback_start_stop" android:src="@drawable/ic_baseline_play_arrow_24" android:contentDescription="@string/voicemail_play_start_pause" app:layout_constraintEnd_toStartOf="@id/delete_entry" app:layout_constraintStart_toEndOf="@id/playback_speakerphone" app:layout_constraintTop_toTopOf="parent" style="@style/VoicemailPlaybackLayoutButtonStyle" />
        <ImageButton android:id="@id/delete_entry" android:src="@drawable/ic_baseline_delete_24" android:contentDescription="@string/call_log_trash_voicemail" app:layout_constraintEnd_toStartOf="@id/callback" app:layout_constraintStart_toEndOf="@id/playback_start_stop" app:layout_constraintTop_toTopOf="parent" style="@style/VoicemailPlaybackLayoutButtonStyle" />
        <ImageButton android:id="@id/callback" android:src="@drawable/ic_baseline_call_24" android:contentDescription="@string/call_log_callback" app:layout_constraintEnd_toStartOf="@id/sms" app:layout_constraintStart_toEndOf="@id/delete_entry" app:layout_constraintTop_toTopOf="parent" style="@style/VoicemailPlaybackLayoutButtonStyle" />
