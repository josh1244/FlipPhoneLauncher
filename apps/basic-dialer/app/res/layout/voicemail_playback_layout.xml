    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView android:textAppearance="@android:style/TextAppearance.Material.Body1" android:textStyle="italic" android:id="@id/transcription" android:layout_width="fill_parent" android:layout_height="wrap_content" />
</LinearLayout>
